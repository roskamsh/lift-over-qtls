colnames(testosterone_gwas)
library(ggplot2)
ggplot(data = testosterone_gwas, mapping = aes(x = OR.or.BETA)) +
geom_histogram()
ggplot(data = testosterone_gwas[testosterone_gwas$OR.or.BETA < 1,], mapping = aes(x = OR.or.BETA)) +
geom_histogram()
## First let's inspect SHBG and apply the sample filters as NR3C1
shbg_filt <- shbg_gwas %>%
select(c("SNPS","CHR_ID","CHR_POS","STRONGEST.SNP.RISK.ALLELE","RISK.ALLELE.FREQUENCY",
"DISEASE.TRAIT","MAPPED_TRAIT","MAPPED_TRAIT_URI","P.VALUE","STUDY","STUDY.ACCESSION",
"INITIAL.SAMPLE.SIZE","DATE.ADDED.TO.CATALOG","OR.or.BETA")) %>%
mutate(RISK.ALLELE = str_split_fixed(STRONGEST.SNP.RISK.ALLELE, "-", 2)[,2],
SAMPLE.SIZE = as.numeric(str_replace_all(str_extract(INITIAL.SAMPLE.SIZE, "\\b\\d{1,}(?:,\\d{3})*\\b"), ",", ""))) %>%
filter(P.VALUE < 5*10^(-8),
RISK.ALLELE != "?",
str_length(RISK.ALLELE)==1) %>%
arrange(desc(SAMPLE.SIZE)) %>%
distinct(SNPS, .keep_all = TRUE)
## Let's see what the numbers look like for testosterone
testosterone_filt <- testosterone_gwas %>%
select(c("SNPS","CHR_ID","CHR_POS","STRONGEST.SNP.RISK.ALLELE","RISK.ALLELE.FREQUENCY",
"DISEASE.TRAIT","MAPPED_TRAIT","MAPPED_TRAIT_URI","P.VALUE","STUDY","STUDY.ACCESSION",
"INITIAL.SAMPLE.SIZE","DATE.ADDED.TO.CATALOG","OR.or.BETA")) %>%
mutate(RISK.ALLELE = str_split_fixed(STRONGEST.SNP.RISK.ALLELE, "-", 2)[,2],
SAMPLE.SIZE = as.numeric(str_replace_all(str_extract(INITIAL.SAMPLE.SIZE, "\\b\\d{1,}(?:,\\d{3})*\\b"), ",", ""))) %>%
filter(P.VALUE < 5*10^(-8),
RISK.ALLELE != "?",
str_length(RISK.ALLELE)==1) %>%
arrange(desc(SAMPLE.SIZE)) %>%
distinct(SNPS, .keep_all = TRUE)
ggplot(data = testosterone_filt[testosterone_filt$OR.or.BETA < 0.4 & testosterone_filt$OR.or.BETA > 0.1,], mapping = aes(x = OR.or.BETA)) +
geom_histogram()
nrow(testosterone_filt[testosterone_filt$OR.or.BETA < 0.4 & testosterone_filt$OR.or.BETA > 0.1,])
View(testosterone_gwas)

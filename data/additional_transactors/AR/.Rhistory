testosterone_gwas <- read.delim("gwas-association-downloaded_2025-02-10-EFO_0004908_testosterone.tsv")
## First let's inspect SHBG and apply the sample filters as NR3C1
shbg_filt <- shbg_gwas %>%
select(c("SNPS","CHR_ID","CHR_POS","STRONGEST.SNP.RISK.ALLELE","RISK.ALLELE.FREQUENCY",
"DISEASE.TRAIT","MAPPED_TRAIT","MAPPED_TRAIT_URI","P.VALUE","STUDY","STUDY.ACCESSION",
"INITIAL.SAMPLE.SIZE","DATE.ADDED.TO.CATALOG","OR.or.BETA","PVALUE_MLOG")) %>%
mutate(RISK.ALLELE = str_split_fixed(STRONGEST.SNP.RISK.ALLELE, "-", 2)[,2],
SAMPLE.SIZE = as.numeric(str_replace_all(str_extract(INITIAL.SAMPLE.SIZE, "\\b\\d{1,}(?:,\\d{3})*\\b"), ",", ""))) %>%
filter(P.VALUE < 5*10^(-8),
RISK.ALLELE != "?",
str_length(RISK.ALLELE)==1) %>%
arrange(desc(SAMPLE.SIZE)) %>%
distinct(SNPS, .keep_all = TRUE)
# Still with these filters we have 1,896 SHBG QTLs
# Let's inspect and filter further based on effect size (BETA), sample size and p-value
shbg_filt %>%
filter(OR.or.BETA < 1) %>%
ggplot(mapping = aes(x = OR.or.BETA)) +
geom_histogram() +
xlab("Odds ratio or Beta") +
theme_minimal()

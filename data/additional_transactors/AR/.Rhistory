shbg_filt %>%
filter(OR.or.BETA < 0.25,
OR.or.BETA > 0.1) %>%
ggplot(mapping = aes(x = OR.or.BETA)) +
geom_histogram() +
xlab("Odds ratio or Beta") +
theme_minimal()
# Around 0.5 are ORs (manually checked) so need to threshold tightly between 0.1 and 0.25
shbg_filt %>%
filter(OR.or.BETA < 0.25,
OR.or.BETA > 0.1) %>%
ggplot(mapping = aes(x = OR.or.BETA)) +
geom_histogram() +
xlab("Effect size") +
theme_minimal()
shbg_filt %>%
filter(OR.or.BETA < 0.25,
OR.or.BETA > 0.1) %>%
ggplot(mapping = aes(x = PVALUE_MLOG, y = OR.or.BETA)) +
geom_point() +
ylab("Effect size") +
xlab("-log10(p-value)") +

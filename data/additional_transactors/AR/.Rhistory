filter(OR.or.BETA < 0.4,
OR.or.BETA > 0.1,
SAMPLE.SIZE > 100000) %>%
ggplot(mapping = aes(PVALUE_MLOG)) +
geom_histogram(bins = 100) +
xlab("-log10(p-value)") +
theme_minimal()
dev.off()
dim(testosterone_pruned)
testosterone_pruned$PVALUE_MLOG
testosterone_filt %>%
filter(OR.or.BETA < 0.4,
OR.or.BETA > 0.1,
SAMPLE.SIZE > 100000,
PVALUE_MLOG > 20) %>% count()
dim(shbg_pruned)
shbg_pruned <- shbg_filt %>%
filter(OR.or.BETA < 0.25,
OR.or.BETA > 0.1,
SAMPLE.SIZE > 100000,
PVALUE_MLOG > 15)
dim(shbg_pruned)
nrow(shbg_pruned)
shbg_filt %>%
filter(OR.or.BETA < 0.25,
OR.or.BETA > 0.1,
SAMPLE.SIZE > 100000,
PVALUE_MLOG > 20)
shbg_pruned <- shbg_filt %>%
filter(OR.or.BETA < 0.25,
OR.or.BETA > 0.1,
SAMPLE.SIZE > 100000,
PVALUE_MLOG > 20)
# Spike near our p-value threshold in the first two bins, so let's remove those (~ PVALUE_MLOG of 15)
testosterone_pruned <- testosterone_filt %>%
filter(OR.or.BETA < 0.4,
OR.or.BETA > 0.1,
SAMPLE.SIZE > 100000,
PVALUE_MLOG > 20)
nrow(testosterone_pruned)
nrow(shbg_pruned)
testosterone_pruned %>%
ggplot(mapping = aes(x = OR.or.BETA)) +
geom_histogram()
